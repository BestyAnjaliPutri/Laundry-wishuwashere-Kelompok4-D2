# CodeIgniter 4 .gitignore

# Environment file (berisi password DB - JANGAN diupload!)
.env

# Vendor (diinstall ulang via composer)
/vendor/

# Writable directories (log, cache, session, upload)
/writable/logs/*
/writable/cache/*
/writable/session/*
/writable/uploads/*
!/writable/logs/.gitkeep
!/writable/cache/.gitkeep
!/writable/session/.gitkeep
!/writable/uploads/.gitkeep

# IDE & OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Node modules (kalau ada)
node_modules/

# Composer lock (optional - bisa diupload untuk reproducible builds)
# composer.lock
