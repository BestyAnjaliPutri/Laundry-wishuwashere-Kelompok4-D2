#--------------------------------------------------------------------
# TEMPLATE ENVIRONMENT — SALIN INI DI RAILWAY SEBAGAI VARIABLE
# Jangan ubah nama file ini — ini hanya contoh
#--------------------------------------------------------------------

# Mode Aplikasi
CI_ENVIRONMENT = production

# URL Aplikasi (isi dengan domain Railway kamu setelah deploy)
# Contoh: https://laundry-wishuwashere-production.up.railway.app/
APP_URL = https://YOUR_APP.up.railway.app/

# Database (Railway mengisi ini otomatis dari plugin MySQL)
# Tapi kamu bisa set manual kalau perlu
MYSQLHOST     = containers-us-west-xxx.railway.app
MYSQLDATABASE = railway
MYSQLUSER     = root
MYSQLPASSWORD = YOUR_PASSWORD_HERE
MYSQLPORT     = 6543
